# Nopetion personal server configuration example.
# New installation: run node scripts/init-env.mjs with Node.js 24 to create .env and fresh secrets.
# The initializer preserves an existing .env. Never put real secrets in this example file.

# Browser-facing URL. Set this before building the image.
# Subpath example: https://your-server.example/nopetion
# Changing the path requires rebuilding the image. The proxy must strip /nopetion.
# Apply the same routing to HTTP and WebSockets. See docs/server-install.md.
APP_URL=http://localhost:3000

# Internal application port. The default Compose deployment uses 3000 inside the container.
PORT=3000
# Optional Compose host port override. The application remains bound to 127.0.0.1.
# NOPETION_PORT=3000
PERSONAL_MODE=true
CLOUD=false

# Infrastructure secrets: init-env.mjs generates random APP_SECRET and database password values.
# APP_SECRET requires at least 32 characters. Do not casually replace secrets on an existing server.
# Create the owner on the first-run screen using Password and Confirm password.
# Do not configure an account email or login password in .env.
APP_SECRET=REPLACE_WITH_LONG_SECRET
JWT_TOKEN_EXPIRES_IN=30d

# The default Compose deployment uses this password for its dedicated PostgreSQL service.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD

# These URLs connect directly to the local services in docker-compose.dev.yml.
# Production Compose overrides them with internal db:5432 and redis:6379 connections.
# The production database and Redis ports are not published to the host.
DATABASE_URL="postgresql://docmost:REPLACE_WITH_RANDOM_DB_PASSWORD@127.0.0.1:5433/docmost"
REDIS_URL=redis://127.0.0.1:6390

# Attachments use a local persistent volume.
STORAGE_DRIVER=local
FILE_UPLOAD_SIZE_LIMIT=50mb
FILE_IMPORT_SIZE_LIMIT=200mb
DISABLE_TELEMETRY=true

# Configure Draw.io, optional Gotenberg and allowed iframe origins in Settings > Server features.
# PDF export uses the built-in exporter by default. Email delivery and email password recovery are unavailable.
